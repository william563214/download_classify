{
  "name": "download-classify",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:e2e": "bash scripts/run-e2e.sh",
    "test:serve": "node tests/helpers/serve_mock_sites.mjs",
    "pack": "bash scripts/pack-store.sh",
    "install:edge": "npm run build && bash scripts/install-edge.sh"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/chrome": "^0.0.287",
    "playwright": "^1.58.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vite-plugin-web-extension": "^4.4.4",
    "vitest": "^5.0.1"
  }
}
